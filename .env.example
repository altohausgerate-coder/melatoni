# Supabase Edge Function secrets (store in Supabase secrets, never in browser code)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_BY_SUPABASE_EDGE_RUNTIME
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_ADMIN_CHAT_ID
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM=Melatoni <orders@your-verified-domain.example>
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY

# Public website config only (configure in analytics-config.js after GTM is created)
MELATONI_GTM_ID=GTM-XXXXXXX
